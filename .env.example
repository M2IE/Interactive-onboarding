# Postgres setting
POSTGRES_USER=avito
POSTGRES_PASSWORD=12345678
POSTGRES_DB=scenarios
POSTGRES_HOST=db_scenarios
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ClickHouse settings
CLICKHOUSE_USER=avito
CLICKHOUSE_PASSWORD=12345678
CLICKHOUSE_DB=analytics
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000

# Gateway setting
GATEWAY_PORT=80

# Analytics are persisted only for these frontend hostnames (comma-separated)
VITE_ANALYTICS_ENABLED_HOSTS=demo.m2ie.ru

# RustFS settings
RUSTFS_ACCESS_KEY=root
RUSTFS_SECRET_KEY=root123456
RUSTFS_ADDRESS=":9000"
RUSTFS_CONSOLE_ADDRESS=":9001"
RUSTFS_CONSOLE_PORT=9001
RUSTFS_REGION=us-east-1
RUSTFS_CONSOLE_ENABLE="true"

# AdminBackend settings
ADMIN_SERVICE_PORT=8001
S3_REPORT_BUCKET=reports
RUSTFS_URL=report_storage # container name for S3

# WidgetBackend settings
WIDGET_SERVICE_PORT=":8002"
