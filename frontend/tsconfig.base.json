{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@interactive-onboarding/shared": ["packages/shared/src/index.ts"],
      "@interactive-onboarding/shared/*": ["packages/shared/src/*"],
      "@interactive-onboarding/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@interactive-onboarding/api-client/*": [
        "packages/api-client/src/*"
      ],
      "@interactive-onboarding/element-selector": [
        "packages/element-selector/src/index.ts"
      ],
      "@interactive-onboarding/element-selector/*": [
        "packages/element-selector/src/*"
      ],
      "@interactive-onboarding/ui": ["packages/ui/src/index.tsx"],
      "@interactive-onboarding/ui/*": ["packages/ui/src/*"],
      "@m2ie/onboarding-sdk": [
        "packages/onboarding-sdk/src/index.ts"
      ],
      "@m2ie/onboarding-sdk/*": [
        "packages/onboarding-sdk/src/*"
      ]
    }
  }
}
